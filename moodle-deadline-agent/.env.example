# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to git.

# --- Moodle connection (required) ---
MOODLE_URL=https://moodle.yourschool.edu
MOODLE_USERNAME=your_username
MOODLE_PASSWORD=your_password
# Alternative to username/password: paste a pre-generated web service token
# and leave MOODLE_USERNAME/MOODLE_PASSWORD blank.
MOODLE_TOKEN=

# Usually "moodle_mobile_app" works out of the box if your institution has
# the mobile app enabled. Ask IT if this fails with an auth error.
MOODLE_SERVICE=moodle_mobile_app

# How many days ahead to look for upcoming deadlines
LOOKAHEAD_DAYS=30

# --- Notion sync (required for notion_sync.py) ---
# Internal integration "Access token" from notion.so -> Developer tools -> Connections.
# Remember to also share your Notion database with this connection.
NOTION_TOKEN=
# The database ID from your Notion database's URL (the 32-char id, dashes optional).
NOTION_DATABASE_ID=

# --- Optional: email delivery instead of/alongside Notion (agent.py --email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
